# ==============================================================================
# ระบบขอเบิกพัสดุและคลังพัสดุดิจิทัล มหาวิทยาลัยสวนดุสิต (Stock Order SDU)
# ไฟล์เทมเพลตกำหนดค่าสภาพแวดล้อมและรหัสผ่าน (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. การตั้งค่าฐานข้อมูล PostgreSQL 17 (Docker Compose & Backend API)
# ------------------------------------------------------------------------------
DB_TYPE="postgres"
DB_HOST="127.0.0.1"
DB_PORT=5433
DB_USER="postgres"
DB_PASSWORD="postgrespassword"
DB_NAME="sdu_inventory"

# ------------------------------------------------------------------------------
# 2. การตั้งค่า pgAdmin 4 สำหรับจัดการฐานข้อมูล (Docker Compose)
# ------------------------------------------------------------------------------
PGADMIN_PORT=5051
PGADMIN_DEFAULT_EMAIL="admin@admin.com"
PGADMIN_DEFAULT_PASSWORD="root"

# ------------------------------------------------------------------------------
# 3. การตั้งค่าเซิร์ฟเวอร์เว็บและ REST API (Python HTTP Server)
# ------------------------------------------------------------------------------
PORT=8080
HOST="127.0.0.1"
BASE_URL="http://localhost:8080"
API_BASE_URL="/api"
ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"

# ------------------------------------------------------------------------------
# 4. รหัสผ่านและคีย์ความปลอดภัยสำหรับเจ้าหน้าที่คลังพัสดุ (Staff Portal)
# ------------------------------------------------------------------------------
STAFF_USERNAME="admin_staff"
STAFF_PASSWORD="sdu1234"
STAFF_AUTH_SECRET="sdu_inventory_staff_secret_token_change_in_production"
ADMIN_PASSWORD_HASH="sha256_or_bcrypt_hash_placeholder"

# ------------------------------------------------------------------------------
# 5. รหัสผ่านและคีย์ความปลอดภัยสำหรับผู้ขอเบิกพัสดุ (Requester Portal)
# ------------------------------------------------------------------------------
DEFAULT_USER_PASSWORD="sdu1234"
REQUESTER_AUTH_SECRET="sdu_inventory_requester_secret_token_change_in_production"

# ------------------------------------------------------------------------------
# 6. โหมดข้ามการ Login สำหรับทดสอบระบบ (ต้องตั้งเป็น "false" เมื่อขึ้นใช้งานจริง!)
# ------------------------------------------------------------------------------
AUTH_BYPASS="false"


