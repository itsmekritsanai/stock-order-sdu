# ==============================================================================
# SDU e-Inventory & Requisition System (.env.example)
# Template environment variables for local development and API deployment
# Copy this file to .env and replace with your actual configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Apps Script Web App Deployment Configuration (Phase 3 & 4)
# ------------------------------------------------------------------------------
# URL ของ Google Apps Script Web App หลังทำการ Deploy (Execute as Me, Access: Anyone)
VITE_GOOGLE_SCRIPT_API_URL="https://script.google.com/macros/s/AKfycbxYOUR_DEPLOYMENT_ID_HERE/exec"
GOOGLE_SHEET_ID="YOUR_SPREADSHEET_ID_HERE"

# ------------------------------------------------------------------------------
# Web Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
HOST="127.0.0.1"
BASE_URL="http://localhost:8080"

# ------------------------------------------------------------------------------
# Security & Authentication (Staff Portal)
# ------------------------------------------------------------------------------
# Session authentication key for warehouse staff portal demo
STAFF_AUTH_SECRET="sdu_inventory_staff_secret_token_change_in_production"
ADMIN_PASSWORD_HASH="sha256_or_bcrypt_hash_placeholder"

# ------------------------------------------------------------------------------
# GitHub Pages Deployment Settings
# ------------------------------------------------------------------------------
GITHUB_REPOSITORY="itsmekritsanai/stock-order-sdu"
GITHUB_PAGES_URL="https://itsmekritsanai.github.io/stock-order-sdu/"
