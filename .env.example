# ==============================================================================
# SDU e-Inventory & Requisition System (.env.example)
# Template environment variables for MySQL Database & REST API Server
# Copy this file to .env and replace with your actual MySQL credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# MySQL Database Configuration (MySQL 8.0+ / MariaDB 10.5+ / XAMPP)
# ------------------------------------------------------------------------------
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="sdu_inventory"

# ------------------------------------------------------------------------------
# Web & REST API Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
HOST="127.0.0.1"
BASE_URL="http://localhost:8080"
API_BASE_URL="/api"

# ------------------------------------------------------------------------------
# Security & Authentication (Staff Portal)
# ------------------------------------------------------------------------------
STAFF_AUTH_SECRET="sdu_inventory_staff_secret_token_change_in_production"
ADMIN_PASSWORD_HASH="sha256_or_bcrypt_hash_placeholder"
